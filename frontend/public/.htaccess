# ============================================================
# SPA Fallback para Vue Router (HTML5 History Mode)
# Apache / XAMPP
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    # 1. SUBRUTA BASE:
    # Coincide con VITE_BASE_PATH=/sisec_2026/
    RewriteBase /sisec_2026/
    # Si la petición es hacia un archivo físico existente (JS, CSS, PNG, PDF, etc.), servir tal cual
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    # Si la petición es hacia un directorio físico existente, servir tal cual
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    # Cualquier otra ruta (ej. /login, /perfil, /dashboard) se redirige a index.html
    # para que Vue Router la resuelva internamente
    RewriteRule ^ index.html [L]
</IfModule>
# ============================================================
# Reglas de Caché (Evita que el navegador retenga versiones viejas)
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    # index.html NUNCA se cachea (para que los usuarios vean cambios al instante tras un build)
    ExpiresByType text/html "access plus 0 seconds"
    # Assets con hash en el nombre (generados por Vite) se pueden cachear
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
